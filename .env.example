# Copie este arquivo para `.env` (ou `.env.local`, que o Git ignora) e preencha os valores.
# Nunca coloque chaves secretas em arquivos versionados.
#
# Valores do projeto Supabase: painel do Supabase > Project Settings > API
# (Project URL, chave "anon"/"publishable" e, só para o servidor, a "service_role"/"secret").

# ---------------------------------------------------------------------------------------------
# Build (Vite). Todas as variáveis VITE_* são EMBUTIDAS no JavaScript do navegador na hora do
# `bun run build`: use apenas valores públicos. Precisam existir no ambiente do build.
# Também servem de reserva para o servidor quando SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY faltam.
# ---------------------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Endereço público do site, sem barra final (ex.: https://www.seudominio.com.br). Usado nas tags de
# compartilhamento (og:image, og:url) e no rel=canonical, que exigem URL absoluta. Sem ele, og:url
# e canonical não são emitidas e og:image fica relativa (WhatsApp, Facebook e X a ignoram). Valor
# público, como as outras VITE_*.
VITE_SITE_URL=

# ---------------------------------------------------------------------------------------------
# Runtime do servidor (Cloudflare Worker ou Node), lidas de process.env a cada requisição.
# No Cloudflare, defina com `wrangler secret put` (veja o README); aqui valem só para rodar local.
# ---------------------------------------------------------------------------------------------

# Opcionais: se faltarem, o servidor usa as VITE_SUPABASE_* acima.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# OBRIGATÓRIA e SECRETA. Ignora o RLS: dá acesso total ao banco. Só no servidor; nunca em VITE_*,
# nunca no Git, nunca no navegador. Usada pela tela de vínculos e pelo bootstrap do primeiro staff.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional. E-mail (confirmado) que pode ativar o perfil da equipe na tela de vínculos, e só enquanto
# não existir nenhum staff. Sem ela esse atalho fica desligado e o primeiro staff é criado por SQL
# (veja o README).
STAFF_BOOTSTRAP_EMAIL=
